# ── VulnScanner API ── Environment Configuration ─────────────────────────────
# Copy this file to .env and adjust values for your environment.
# Never commit the actual .env file.

# Application
APP_NAME=VulnScanner API
APP_VERSION=1.0.0
APP_ENV=development

# Server
API_HOST=127.0.0.1
API_PORT=8000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Database — PostgreSQL connection string (placeholder credentials only!)
DATABASE_URL=postgresql+psycopg://vulnscanner:changeme@localhost:5432/vulnscanner

# Required before saving Jira, Slack, or Splunk secrets. Generate locally with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# Browser authentication cookie. Enable Secure cookies for HTTPS deployments.
SESSION_COOKIE_NAME=vulnscanner_session
SESSION_COOKIE_SECURE=false

# Network discovery safety bounds
DISCOVERY_MAX_ADDRESSES=4096
DISCOVERY_TIMEOUT_SECONDS=300
