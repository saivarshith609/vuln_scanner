# ── VulnScanner API ── Environment Configuration ─────────────────────────────
# Copy this file to .env for local development, or configure these variables in
# Render for production. Never commit the actual .env file or real secrets.

# Application (set APP_ENV=production in production)
APP_NAME=VulnScanner API
APP_VERSION=1.0.0
APP_ENV=development

# Server (in Render production, bind 0.0.0.0 and use $PORT)
API_HOST=127.0.0.1
API_PORT=8000

# CORS — comma-separated allowed frontend origins (no trailing slashes)
# Production example: https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:5173

# Database — PostgreSQL connection string (placeholder credentials only)
# Hosted PostgreSQL (e.g., Supabase) may use postgres:// or postgresql://;
# the backend normalizes both to postgresql+psycopg:// for Psycopg 3.
# Production example: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://vulnscanner:changeme@localhost:5432/vulnscanner

# Required before saving Jira, Slack, or Splunk secrets. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# Browser authentication cookie.
# MUST be true when APP_ENV=production (startup refuses false in production).
SESSION_COOKIE_NAME=vulnscanner_session
SESSION_COOKIE_SECURE=false

# Scanner runtime bounds (leave NMAP_EXECUTABLE blank to auto-detect on PATH)
NMAP_EXECUTABLE=
NMAP_TIMEOUT_SECONDS=600
NMAP_MAX_CONCURRENT=3
NMAP_MAX_OUTPUT_BYTES=10485760

# Network discovery safety bounds
DISCOVERY_MAX_ADDRESSES=4096
DISCOVERY_TIMEOUT_SECONDS=300
